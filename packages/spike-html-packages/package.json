{
  "name": "@jaimestill/spike-html-packages",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./css": {
      "types": "./dist/css.d.ts"
    },
    "./foundation/format.js": {
      "types": "./dist/foundation/format.d.ts"
    },
    "./foundation/*.js": {
      "types": "./dist/foundation/*.d.ts",
      "default": "./dist/foundation/*.js"
    },
    "./foundation/*.css": "./dist/foundation/*.css",
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./components/*.css": "./dist/components/*.css",
    "./sdk/*.js": {
      "types": "./dist/sdk/*.d.ts"
    }
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@jaimestill/spike-html-packages-components": "workspace:*",
    "@jaimestill/spike-html-packages-foundation": "workspace:*",
    "@jaimestill/spike-html-packages-sdk": "workspace:*"
  }
}
