// The package's build, src/ into dist/: tsc emits each module's .js and .d.ts. The ambient "*.css"
// declaration is the foundation's ./css types subpath, read through the declared dependency.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["@jaimestill/spike-html-packages-foundation/css"]
  },
  "include": ["src"]
}
