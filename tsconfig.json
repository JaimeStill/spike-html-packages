// The compiler options every package and check shares, over the demo's modules here. Each package's
// tsconfig.json extends it to build its src/ into its dist/; test/browser/tsconfig.json checks the
// browser cases against the one package's build.
// Adapted from spike-html-conventions (a88828a): tsconfig.json, its include narrowed to the demo.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["demo"]
}
