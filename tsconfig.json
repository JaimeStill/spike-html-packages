// Adapted from spike-html-conventions a88828a: tsconfig.json, its include narrowed to the typed
// sources: the layers, the demo's modules, and the browser tier's case modules.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["layers", "demo", "test/browser/support/*.ts"]
}
