// Adapted from spike-html-conventions a88828a: tsconfig.json, its include narrowed to layers/, the
// typed sources this repository holds; the tests and scripts are plain JavaScript outside it.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["layers"]
}
